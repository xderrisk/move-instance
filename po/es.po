#: prefs.js:13
msgid "WM_CLASS Configuration"
msgstr "Configuración de WM_CLASS"

#: prefs.js:14
msgid "Add window class names (e.g., Spotify) to force moving."
msgstr "Añade nombres WM_CLASS (ej: Spotify) para forzar el movimiento."

#: prefs.js:21
msgid "Treat all apps as single instance"
msgstr "Trate todas las aplicaciones como una instancia única"

#: prefs.js:23
msgid ""
"Move any dragged app to the current workspace instead of launching a new "
"window"
msgstr ""
"Mueva cualquier aplicación arrastrada al espacio de trabajo actual en lugar "
"de abrir una nueva ventana"

#: prefs.js:30
msgid "WM_CLASS List (comma separated)"
msgstr "Lista de WM_CLASS (separada por comas)"
