#: prefs.js:13
msgid "Configuration"
msgstr "Configuración"

#: prefs.js:20
msgid "Treat all apps as single instance"
msgstr "Trate todas las aplicaciones como una instancia única"

#: prefs.js:22
msgid ""
"Move any dragged app to the current workspace instead of launching a new "
"window"
msgstr ""
"Mueva cualquier aplicación arrastrada al espacio de trabajo actual en lugar "
"de abrir una nueva ventana"

#: prefs.js:35
msgid "Force specific apps by adding their wmclass (comma separated)."
msgstr ""
"Fuerce aplicaciones específicas agregando su wmclass (separadas por comas)."

#: prefs.js:42
msgid ""
"e.g. or.gnome.Nautilus, firefox-esr, org.gnome.Console\n"
"Find it with Looking Glass (Alt+F2, lg) → Windows."
msgstr ""
"p.ej. o.gnome.Nautilus, firefox-esr, org.gnome.Console \n"
"Encuéntrelo con Looking Glass (Alt+F2, lg) → Windows."
